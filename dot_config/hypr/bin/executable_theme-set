#!/bin/bash
set -euo pipefail

# === Configuration ===
THEMES_DIR="$HOME/.config/hypr/themes"
CURRENT_THEME_DIR="$THEMES_DIR/current/theme"
DEBUG="${DEBUG:-0}"
failed_updates=()

# === Functions ===
die() {
  echo "Error: $1" >&2
  exit "${2:-1}"
}

update() {
  if ! "$@"; then
    printf 'Warning: theme update failed: %s\n' "$*" >&2
    failed_updates+=("$*")
  fi
}

debug_log() {
  [[ "$DEBUG" == "1" ]] && notify-send -t 5000 "Debug Script" "$1"
  return 0
}

validate_theme() {
  local config
  [[ -d "$1" ]] || return 1
  for config in qt6ct.conf kvantum/kvantum.kvconfig; do
    if [[ ! -f "$1/$config" || ! -r "$1/$config" ]]; then
      printf 'Error: Missing or unreadable theme config: %s\n' "$1/$config" >&2
      return 1
    fi
  done
}

available_themes() {
  local path
  for path in "$THEMES_DIR"/*; do
    [[ "${path##*/}" == current || "${path##*/}" == --list ]] && continue
    if validate_theme "$path" 2>/dev/null; then
      printf '%s\n' "${path##*/}"
    fi
  done | sort
}

list_themes() {
  echo "Available themes:" >&2
  available_themes | sed 's/^/  - /' >&2
}

# === Argument validation ===
if [[ "${1:-}" == --list ]]; then
  available_themes
  exit 0
fi

if [[ -z "${1:-}" ]]; then
  echo "Usage: $(basename "$0") <theme-name> | --list" >&2
  list_themes
  exit 1
fi

# Preserve exact basenames returned by --list; normalize only shorthand input.
THEME_NAME="$1"
[[ "$THEME_NAME" != */* && "$THEME_NAME" != . && "$THEME_NAME" != .. ]] ||
  die "Invalid theme basename"
if [[ ! -d "$THEMES_DIR/$THEME_NAME" ]]; then
  clean_input="${1//[<>\"\']/}"
  clean_input="${clean_input//../}"
  THEME_NAME="${clean_input// /-}"
  THEME_NAME="${THEME_NAME,,}"
fi

[[ -z "$THEME_NAME" ]] && die "Invalid theme name after sanitization"

# Block 'current' as theme name
[[ "$THEME_NAME" == "current" ]] && die "'current' is a reserved name"

# === Verify theme existence ===
THEME_PATH="$THEMES_DIR/$THEME_NAME"

debug_log "Il percorso è: $THEME_PATH"

# === Verifica esistenza tema ===
if [[ ! -d "$THEME_PATH" ]]; then
  echo "Error: Theme '$THEME_NAME' not found." >&2
  list_themes
  exit 1
fi

validate_theme "$THEME_PATH" || exit 1

# === Verify/create current directory ===
CURRENT_DIR="$THEMES_DIR/current"
[[ ! -d "$CURRENT_DIR" ]] && mkdir -p "$CURRENT_DIR"

# === Update symlink ===
ln -snf "$THEME_PATH" "$CURRENT_THEME_DIR"

# qt6ct watches this directory, not the theme symlink; Kvantum colors may still need an app restart.
update touch "$HOME/.config/qt6ct"

# Change background with theme
update theme-bg-next

# Reload components to apply new theme
update reload-app waybar

update restart-terminal
update hyprctl reload

update reload-app btop


# makoctl reload
update swaync-client --skip-wait -R
update swaync-client --skip-wait -rs

update theme-set-gnome

# theme-set-browser
update theme-set-obsidian

# Set Neovim colorscheme
update theme-set-neovim "$THEME_PATH"

update restart-app dolphin
update restart-app krusader

if ((${#failed_updates[@]})); then
  timeout 3s notify-send "Tema applicato con avvisi" "$(printf '%s\n' "${failed_updates[@]}")" || true
fi
# Call hook on theme set
# hook theme-set "$THEME_NAME"
