#!/usr/bin/env bash

# Exit early if we don't have the tte show
if ! "$HOME/.local/share/mise/shims/tte" --version &>/dev/null; then
  exit 1
fi

# Exit early if screensave is already running
pgrep -f '[o]rg.hyprarch.screensaver' >/dev/null && exit 0

# Allow screensaver to be turned off but also force started
if [[ -f ~/.local/state/hyprarch/toggles/screensaver-off ]] && [[ $1 != "force" ]]; then
  exit 1
fi

# Silently quit Walker on overlay
walker -q

focused=$(hyprctl monitors -j | jq -r '.[] | select(.focused == true).name')
if command -v ghostty &>/dev/null; then
  terminal=ghostty
else
  terminal=$(xdg-terminal-exec --print-id)
fi

for m in $(hyprctl monitors -j | jq -r '.[] | .name'); do
  hyprctl eval "hl.dispatch(hl.dsp.focus({ monitor = '$m' }))"

  case $terminal in
  *Alacritty*)
    hyprctl eval "hl.dispatch(hl.dsp.exec_cmd('alacritty --class=org.hyprarch.screensaver \
      --config-file ~/.config/alacritty/screensaver.toml \
      -e cmd-screensaver', { monitor = '$m' }))"
    ;;
  *ghostty*)
    hyprctl eval "hl.dispatch(hl.dsp.exec_cmd('ghostty --class=org.hyprarch.screensaver \
      --config-default-files=false \
      --config-file=$HOME/.config/ghostty/screensaver \
      -e $HOME/.config/hypr/bin/cmd-screensaver', { monitor = '$m' }))"
    ;;
  *kitty*)
    hyprctl eval "hl.dispatch(hl.dsp.exec_cmd('kitty --class=org.hyprarch.screensaver \
      --override font_size=18 \
      --override window_padding_width=0 \
      -e cmd-screensaver', { monitor = '$m' }))"
    ;;
  *)
    notify-send "✋  Screensaver only runs in Alacritty, Ghostty, or Kitty"
    ;;
  esac
done

hyprctl eval "hl.dispatch(hl.dsp.focus({ monitor = '$focused' }))"
