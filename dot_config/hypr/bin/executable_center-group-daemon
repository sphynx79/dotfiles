#!/usr/bin/python3
"""Demone del gruppo centrale per il layout a tre zone (layouts/three-zone.lua).

Ascolta gli eventi Hyprland su socket2 e mantiene UN gruppo con le finestre
della zona centrale (classi in THREE_ZONE_CENTER_CLASSES di three-zone.conf):
  - alla seconda finestra centrale crea il gruppo;
  - le finestre centrali successive vengono inserite nel gruppo esistente;
  - browser e Dolphin non vengono mai toccati (whitelist + window rule "barred");
  - floating, pinned, fullscreen, special workspace e finestre non in whitelist
    sono sempre esclusi.

Il layout Lua tiene il gruppo IN CIMA alla pila centrale, quindi l'inserimento
avviene in modo deterministico con "move into_group up" sulla finestra libera
piu' in alto (quella subito sotto il gruppo).

Mantiene inoltre la cronologia MRU delle finestre (per bin/center-window-switcher)
in $XDG_RUNTIME_DIR/hypr-three-zone-mru, una address per riga.

Uso:
  center-group-daemon              # demone (systemd: hypr-center-group.service)
  center-group-daemon --oneshot    # una passata di riconciliazione ed esce
  center-group-daemon --reset      # scioglie i gruppi centrali e li ricostruisce
  center-group-daemon --adopt      # con --reset/--oneshot: rimette in tiling le
                                   # finestre float di classi note (migrazione)

Dipendenze di versione (Hyprland 0.55, config Lua): i dispatcher passano da
`hyprctl eval "hl.dispatch(hl.dsp....)"`; i nomi evento di socket2 sono invariati.
"""

import json
import os
import select
import socket
import subprocess
import sys
import time

CONF_PATH = os.path.expanduser("~/.config/hypr/three-zone.conf")
RUNTIME = os.environ.get("XDG_RUNTIME_DIR", f"/run/user/{os.getuid()}")
MRU_PATH = os.path.join(RUNTIME, "hypr-three-zone-mru")

# NB: su 0.55.x "togglegroup" non veniva emesso su socket2 (distruzione manuale
# del gruppo dedotta in manage_ws con il diff di stato sulla passata precedente);
# la 0.56 lo ha ripristinato (PR #14089), quindi qui triggera subito la
# riconciliazione. Il diff di stato resta come fallback.
RELEVANT_EVENTS = {
    "openwindow", "closewindow", "movewindow", "movewindowv2",
    "workspace", "workspacev2", "changefloatingmode",
    "moveintogroup", "moveoutofgroup", "togglegroup",
}
MAX_BURST = 8      # azioni massime per riconciliazione (anti-loop)
MRU_CAP = 64


def log(msg):
    print(f"[center-group] {msg}", flush=True)


def load_conf(path=CONF_PATH):
    conf = {}
    try:
        with open(path) as f:
            for line in f:
                line = line.strip()
                if not line or line.startswith("#") or "=" not in line:
                    continue
                key, _, val = line.partition("=")
                conf[key.strip()] = val.strip().strip('"')
    except OSError as e:
        log(f"config non leggibile ({e}), uso i default")
    return conf


_conf_mtime = None


def refresh_conf():
    """Ricarica three-zone.conf se e' cambiato (hot reload, controllo su mtime)."""
    global _conf_mtime, MONITOR, WORKSPACES, CENTER_CLASSES, ZONE_CLASSES
    global DEBOUNCE, ACTION_GUARD, UNGROUP_COOLDOWN, ADOPT_SKIP
    try:
        mtime = os.path.getmtime(CONF_PATH)
    except OSError:
        mtime = None
    if mtime == _conf_mtime:
        return False
    first = _conf_mtime is None
    _conf_mtime = mtime

    conf = load_conf()
    MONITOR = conf.get("THREE_ZONE_MONITOR", "DP-1")
    WORKSPACES = {int(w) for w in conf.get("THREE_ZONE_WORKSPACES", "1").split()}
    CENTER_CLASSES = set(conf.get("THREE_ZONE_CENTER_CLASSES", "").split())
    ZONE_CLASSES = CENTER_CLASSES \
        | set(conf.get("THREE_ZONE_LEFT_CLASSES", "").split()) \
        | set(conf.get("THREE_ZONE_RIGHT_CLASSES", "").split())
    DEBOUNCE = float(conf.get("THREE_ZONE_DEBOUNCE", "0.15"))
    ACTION_GUARD = float(conf.get("THREE_ZONE_ACTION_GUARD", "0.4"))
    UNGROUP_COOLDOWN = float(conf.get("THREE_ZONE_UNGROUP_COOLDOWN", "60"))
    ADOPT_SKIP = set(conf.get("THREE_ZONE_ADOPT_SKIP", "obsidian").split())
    if not first:
        log(f"config ricaricata: ws={sorted(WORKSPACES)} "
            f"center={sorted(CENTER_CLASSES)}")
    return not first


refresh_conf()


# ---------------------------------------------------------------- hyprctl IPC

def hyprctl_json(cmd):
    try:
        out = subprocess.run(["hyprctl", "-j", cmd], capture_output=True,
                             text=True, timeout=5)
        if out.returncode != 0:
            log(f"hyprctl {cmd} fallito: {out.stderr.strip()}")
            return None
        return json.loads(out.stdout)
    except (subprocess.TimeoutExpired, json.JSONDecodeError, OSError) as e:
        log(f"hyprctl {cmd} errore: {e}")
        return None


def hl_dispatch(expr):
    """Esegue un dispatcher Lua (in modalita' Lua `hyprctl dispatch <keyword>` non esiste)."""
    try:
        out = subprocess.run(["hyprctl", "eval", f"hl.dispatch({expr})"],
                             capture_output=True, text=True, timeout=5)
        if out.returncode != 0 or "error" in out.stdout.lower():
            log(f"dispatch fallito: {expr} -> {out.stdout.strip()} {out.stderr.strip()}")
            return False
        return True
    except (subprocess.TimeoutExpired, OSError) as e:
        log(f"dispatch errore: {e}")
        return False


def socket2_path():
    sig = os.environ.get("HYPRLAND_INSTANCE_SIGNATURE")
    base = os.path.join(RUNTIME, "hypr")
    if not sig:
        # fallback: l'istanza piu' recente (dopo un restart di Hyprland la
        # signature nell'ambiente del servizio puo' essere vecchia)
        try:
            dirs = sorted((os.path.getmtime(os.path.join(base, d)), d)
                          for d in os.listdir(base))
            sig = dirs[-1][1] if dirs else None
        except OSError:
            sig = None
    if not sig:
        return None
    return os.path.join(base, sig, ".socket2.sock")


# ------------------------------------------------------------ classificazione

def eligible_center(w, ws_id, monitor_id):
    """Finestra candidata al gruppo centrale (whitelist esplicita)."""
    return (
        w.get("class") in CENTER_CLASSES
        and w.get("mapped")
        and not w.get("hidden")
        and not w.get("floating")
        and not w.get("pinned")
        and not w.get("fullscreen")           # 0 = nessun fullscreen
        and (w.get("workspace") or {}).get("id") == ws_id
        and not str((w.get("workspace") or {}).get("name", "")).startswith("special:")
        and w.get("monitor") == monitor_id
    )


def monitor_id_for(name):
    monitors = hyprctl_json("monitors") or []
    for m in monitors:
        if m.get("name") == name:
            return m.get("id")
    return None


# ------------------------------------------------------------------- demone

class Daemon:
    def __init__(self):
        self.anchor = {}            # ws -> address di un membro del gruppo
        self.last_group = {}        # ws -> set di address dell'ultimo gruppo visto
        self.cooldown_until = {}    # ws -> monotonic: niente auto-group fino ad allora
        self.mru = []               # address, piu' recente per prima

    # -- MRU ------------------------------------------------------------
    def touch_mru(self, addr):
        if not addr.startswith("0x"):
            addr = "0x" + addr
        if self.mru and self.mru[0] == addr:
            return
        if addr in self.mru:
            self.mru.remove(addr)
        self.mru.insert(0, addr)
        del self.mru[MRU_CAP:]
        try:
            with open(MRU_PATH, "w") as f:
                f.write("\n".join(self.mru) + "\n")
        except OSError:
            pass

    def drop_mru(self, addr):
        if not addr.startswith("0x"):
            addr = "0x" + addr
        if addr in self.mru:
            self.mru.remove(addr)

    # -- riconciliazione --------------------------------------------------
    def reconcile(self, allow_group=True):
        """Una passata su tutti i workspace gestiti. Ritorna True se ha agito."""
        refresh_conf()
        monitor_id = monitor_id_for(MONITOR)
        if monitor_id is None:
            return False
        clients = hyprctl_json("clients")
        if clients is None:
            return False

        acted = False
        for ws in WORKSPACES:
            acted |= self.manage_ws(ws, monitor_id, clients, allow_group)
        return acted

    def manage_ws(self, ws, monitor_id, clients, allow_group=True):
        center = [w for w in clients if eligible_center(w, ws, monitor_id)]
        grouped = [w for w in center if w.get("grouped")]
        free = sorted((w for w in center if not w.get("grouped")),
                      key=lambda w: (w.get("at") or [0, 0])[1])

        # aggiorna/invalida l'anchor del gruppo per questo workspace
        if grouped:
            addrs = {w["address"] for w in grouped}
            if self.anchor.get(ws) not in addrs:
                self.anchor[ws] = grouped[0]["address"]
            self.last_group[ws] = addrs
            if self.cooldown_until.pop(ws, None):
                log(f"ws{ws}: gruppo di nuovo presente, pausa annullata")
        else:
            self.anchor.pop(ws, None)
            # gruppo sparito ma membri ancora vivi e in tiling: ungroup manuale
            # (0.55.4 non emette eventi per il toggle, va dedotto dallo stato)
            prev = self.last_group.pop(ws, set())
            alive = prev & {w["address"] for w in free}
            if len(alive) >= 2:
                self.cooldown_until[ws] = time.monotonic() + UNGROUP_COOLDOWN
                log(f"ws{ws}: ungroup manuale rilevato, auto-group in pausa "
                    f"per {UNGROUP_COOLDOWN:.0f}s")
                return False

        if not allow_group or time.monotonic() < self.cooldown_until.get(ws, 0):
            return False

        if not free:
            return False

        if grouped:
            # il layout tiene il gruppo in cima: la finestra libera piu' in alto
            # ha il gruppo direttamente sopra di se'
            target = free[0]["address"]
            log(f"ws{ws}: inserisco {free[0]['class']} {target} nel gruppo")
            return hl_dispatch(
                f"hl.dsp.window.move({{ into_group = 'u', window = 'address:{target}' }})")

        if len(free) >= 2:
            # nessun gruppo: la seconda finestra dall'alto si unisce alla prima
            target = free[1]["address"]
            log(f"ws{ws}: creo il gruppo con {free[0]['class']} + {free[1]['class']}")
            return hl_dispatch(
                f"hl.dsp.window.move({{ into_or_create_group = 'u', window = 'address:{target}' }})")

        return False

    def reconcile_burst(self, allow_group=True):
        """Riconcilia fino a stabilita', preservando il focus dell'utente."""
        before = hyprctl_json("activewindow") or {}
        focus = before.get("address")

        for _ in range(MAX_BURST):
            if not self.reconcile(allow_group):
                break
            time.sleep(ACTION_GUARD)
        else:
            log("burst interrotto: raggiunto il limite di azioni (possibile loop?)")

        if focus:
            after = hyprctl_json("activewindow") or {}
            if after.get("address") != focus:
                hl_dispatch(f"hl.dsp.focus({{ window = 'address:{focus}' }})")

    # -- reset / adozione -------------------------------------------------
    def adopt_floating(self):
        """Migrazione: rimette in tiling le finestre float di classi note."""
        monitor_id = monitor_id_for(MONITOR)
        clients = hyprctl_json("clients") or []
        for w in clients:
            if (w.get("class") in ZONE_CLASSES
                    and w.get("class") not in ADOPT_SKIP
                    and w.get("floating") and not w.get("pinned")
                    and w.get("mapped") and not w.get("hidden")
                    and (w.get("workspace") or {}).get("id") in WORKSPACES
                    and w.get("monitor") == monitor_id):
                log(f"adopt: {w['class']} {w['address']} -> tiled")
                hl_dispatch(
                    f"hl.dsp.window.float({{ action = 'disable', window = 'address:{w['address']}' }})")
                time.sleep(0.1)

    def reset(self):
        """Scioglie i gruppi delle finestre centrali e li ricostruisce da zero."""
        monitor_id = monitor_id_for(MONITOR)
        clients = hyprctl_json("clients") or []
        seen = set()
        for ws in WORKSPACES:
            for w in clients:
                if not eligible_center(w, ws, monitor_id):
                    continue
                group = frozenset(w.get("grouped") or [])
                if group and group not in seen:
                    seen.add(group)
                    log(f"reset: sciolgo il gruppo di {w['class']} {w['address']}")
                    hl_dispatch(
                        f"hl.dsp.group.toggle({{ window = 'address:{w['address']}' }})")
                    time.sleep(ACTION_GUARD)
            self.cooldown_until.pop(ws, None)
        self.reconcile_burst()

    # -- eventi -----------------------------------------------------------
    def on_event(self, name, data):
        if name == "activewindowv2":
            addr = data.strip().rstrip(",")
            if addr:
                self.touch_mru(addr)
            return False
        if name == "closewindow":
            self.drop_mru(data.strip())
            return True
        if name == "moveoutofgroup":
            # estrazione manuale dal gruppo: non reinserirla subito
            for ws in WORKSPACES:
                self.cooldown_until[ws] = time.monotonic() + UNGROUP_COOLDOWN
            log(f"moveoutofgroup: auto-group in pausa per {UNGROUP_COOLDOWN:.0f}s")
            return False
        return name in RELEVANT_EVENTS

    def run(self):
        log(f"avvio: monitor={MONITOR} ws={sorted(WORKSPACES)} "
            f"center={sorted(CENTER_CLASSES)}")
        self.reconcile_burst()
        backoff = 1.0
        while True:
            path = socket2_path()
            if not path or not os.path.exists(path):
                log(f"socket2 non trovato ({path}), riprovo tra {backoff:.0f}s")
                time.sleep(backoff)
                backoff = min(backoff * 2, 15)
                continue
            try:
                with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as sock:
                    sock.connect(path)
                    log(f"connesso a {path}")
                    backoff = 1.0
                    self.event_loop(sock)
            except OSError as e:
                log(f"socket2: {e}, riconnessione tra {backoff:.0f}s")
                time.sleep(backoff)
                backoff = min(backoff * 2, 15)

    def poke_layout(self):
        """Forza un recalculate del layout (hot reload di three-zone.conf).

        Il layout_msg arriva solo all'algoritmo del workspace attivo, quindi
        va mandato solo se e' uno dei nostri (su dwindle darebbe errore).
        """
        active = hyprctl_json("activeworkspace") or {}
        if active.get("id") in WORKSPACES:
            hl_dispatch("hl.dsp.layout('three-zone:refresh')")

    def event_loop(self, sock):
        buf = b""
        pending = False
        deadline = 0.0
        while True:
            # a riposo si sveglia comunque ogni 2s per l'hot reload della config
            timeout = max(0.0, deadline - time.monotonic()) if pending else 2.0
            ready, _, _ = select.select([sock], [], [], timeout)
            if ready:
                chunk = sock.recv(4096)
                if not chunk:
                    raise OSError("socket2 chiuso")
                buf += chunk
                while b"\n" in buf:
                    line, buf = buf.split(b"\n", 1)
                    name, _, data = line.decode(errors="replace").partition(">>")
                    if self.on_event(name, data):
                        pending = True
                        deadline = time.monotonic() + DEBOUNCE
            if pending and time.monotonic() >= deadline:
                pending = False
                self.reconcile_burst()
            elif not pending and refresh_conf():
                self.poke_layout()
                self.reconcile_burst()


def main():
    args = set(sys.argv[1:])
    daemon = Daemon()
    if "--reset" in args or "--oneshot" in args:
        if "--adopt" in args:
            daemon.adopt_floating()
            time.sleep(ACTION_GUARD)
        if "--reset" in args:
            daemon.reset()
        else:
            daemon.reconcile_burst()
        return
    daemon.run()


if __name__ == "__main__":
    main()
