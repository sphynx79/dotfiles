#!/bin/bash
# Overlay walker (SUPER+TAB) delle finestre centrali del layout a tre zone.
#
# Mostra solo le finestre della zona centrale del workspace corrente sul monitor
# ultrawide (classi in THREE_ZONE_CENTER_CLASSES o membri del gruppo centrale),
# ordinate per focus piu' recente (MRU scritta da center-group-daemon).
# La selezione avviene per INDICE (walker --dmenu --index): il testo mostrato
# non viene mai riusato per risalire alla finestra, si usa l'address Hyprland.
set -euo pipefail

source "$HOME/.config/hypr/three-zone.conf"

mon_json=$(hyprctl -j monitors | jq -c --arg n "$THREE_ZONE_MONITOR" '.[] | select(.name == $n)')
[[ -z "$mon_json" ]] && exit 0
mon_id=$(jq -r '.id' <<<"$mon_json")
ws_id=$(jq -r '.activeWorkspace.id' <<<"$mon_json")

# address \t attiva(true/false) \t classe \t titolo (troncato)
mapfile -t rows < <(hyprctl -j clients | jq -r \
  --argjson ws "$ws_id" --argjson mon "$mon_id" \
  --arg classes "$THREE_ZONE_CENTER_CLASSES" '
  ($classes | split(" ")) as $cc |
  .[]
  | select(
      .mapped and (.hidden | not) and (.floating | not) and (.pinned | not)
      and .fullscreen == 0
      and .workspace.id == $ws and .monitor == $mon
      and ((.class as $c | ($cc | index($c)) != null) or ((.grouped | length) > 0))
    )
  | [.address, (.focusHistoryID == 0), .class, (.title[0:70])] | @tsv')

[[ ${#rows[@]} -eq 0 ]] && exit 0

# Riordino MRU: prima le address della cronologia del demone, poi il resto
declare -A by_addr=()
order=()
for row in "${rows[@]}"; do
  addr=${row%%$'\t'*}
  by_addr[$addr]=$row
  order+=("$addr")
done

sorted=()
if [[ -r "${XDG_RUNTIME_DIR:-/run/user/$UID}/hypr-three-zone-mru" ]]; then
  while read -r addr; do
    [[ -n "${by_addr[$addr]:-}" ]] && sorted+=("$addr")
  done < "${XDG_RUNTIME_DIR:-/run/user/$UID}/hypr-three-zone-mru"
fi
for addr in "${order[@]}"; do
  found=0
  for s in "${sorted[@]:-}"; do [[ $s == "$addr" ]] && found=1 && break; done
  [[ $found -eq 0 ]] && sorted+=("$addr")
done

lines=()
addrs=()
for addr in "${sorted[@]}"; do
  IFS=$'\t' read -r _ active class title <<<"${by_addr[$addr]}"
  marker="  "
  [[ $active == "true" ]] && marker="● "
  lines+=("$(printf '%s%-12s — %s' "$marker" "$class" "$title")")
  addrs+=("$addr")
done

idx=$(printf '%s\n' "${lines[@]}" \
  | walker --dmenu --index -p "Finestre centrali" -t menus -N) || exit 0

[[ "$idx" =~ ^[0-9]+$ ]] || exit 0
addr=${addrs[$idx]:-}
[[ -z "$addr" ]] && exit 0

# focuswindow su un membro del gruppo lo rende anche la finestra visibile del gruppo
exec hyprctl eval "hl.dispatch(hl.dsp.focus({ window = 'address:${addr}' }))" >/dev/null
