#!/bin/bash

# 1. Chiudi wlogout se è già in esecuzione
if pgrep -x "wlogout" >/dev/null; then
    pkill -x "wlogout"
    exit 0
fi

# 2. Definizione dei percorsi
layout=~/.config/wlogout/layout
template=~/.config/wlogout/style.css
theme=~/.config/hypr/themes/current/theme

# Controllo esistenza file
if [[ ! -r "$layout" || ! -r "$template" || ! -r "$theme/gnome.theme" || ! -r "$theme/wlogout.css" ]]; then
    notify-send -u critical "Wlogout Error" "Layout, CSS o configurazione del tema mancante o non leggibile"
    exit 1
fi

# ---------------------------------------------------------
# 3. Rilevamento Tema (Dark/Light)
# ---------------------------------------------------------
# Usa lo stesso schema del tema selezionato, senza dipendere da gsettings.
# shellcheck disable=SC1091
source "$theme/gnome.theme"

if [[ "$COLOR_SCHEME" == "prefer-dark" ]]; then
    # Se il sistema è Dark, le icone devono essere chiare
    export BtnCol="white"
else
    # Se il sistema è Light (o default), le icone devono essere scure
    export BtnCol="black"
fi

# ---------------------------------------------------------
# 4. Rilevamento Monitor e Scaling
# ---------------------------------------------------------
if ! read -r x_mon y_mon < <(hyprctl -j monitors | jq -r '
    .[] | select(.focused == true) |
    [(.width / .scale | floor), (.height / .scale | floor)] | @tsv
'); then
    notify-send -u critical "Wlogout Error" "Impossibile determinare le dimensioni del monitor attivo"
    exit 1
fi

# 5. Calcolo dimensioni e margini
export x_mgn=$((x_mon * 35 / 100))
export y_mgn=$((y_mon * 25 / 100))
export x_hvr=$((x_mon * 32 / 100))
export y_hvr=$((y_mon * 20 / 100))

# Calcolo font e raggio bordi
export fntSize=$((y_mon * 2 / 100))
hypr_border="${hypr_border:-10}"
export active_rad=$((hypr_border * 5))
export button_rad=$((hypr_border * 8))

# 6. Generazione CSS dinamico
# envsubst sostituirà ${BtnCol} con "white" o "black" nel tuo CSS (anche dentro gli SVG)
wlStyle="$(envsubst < "$template")"

# 7. Avvio wlogout
wlogout -b 2 -c 0 -r 0 -m 0 --layout "$layout" --css <(echo "$wlStyle") --protocol layer-shell
