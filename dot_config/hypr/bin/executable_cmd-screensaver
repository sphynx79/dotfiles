#!/usr/bin/env bash

screensaver_in_focus() {
  hyprctl activewindow -j | jq -e '.class == "org.hyprarch.screensaver"' >/dev/null 2>&1
}

exit_screensaver() {
  local status=$?
  trap - EXIT SIGINT SIGTERM SIGHUP SIGQUIT
  hyprctl eval 'hl.config({ cursor = { invisible = false } })' &>/dev/null
  if [[ -n ${effect_pid:-} ]]; then
    kill "$effect_pid" 2>/dev/null
    wait "$effect_pid" 2>/dev/null
  fi
  pkill -f '[o]rg.hyprarch.screensaver' 2>/dev/null
  exit "$status"
}

# Exit the screensaver on signals and input from keyboard and mouse
trap exit_screensaver EXIT
trap 'exit 0' SIGINT SIGTERM SIGHUP SIGQUIT
printf '\e[?1000h\e[?1003h'         # Enable mouse tracking (clicks: 1000, movement: 1003)
while read -rsn1 -t 0.1; do :; done # Flush any pending input

printf '\033]11;rgb:00/00/00\007' # Set background color to black

hyprctl eval 'hl.config({ cursor = { invisible = true } })' &>/dev/null

while true; do
  "$HOME/.local/share/mise/shims/tte" -i ~/.config/hypr/screensaver.txt \
    --frame-rate 120 --canvas-width 0 --canvas-height 0 --reuse-canvas --anchor-canvas c --anchor-text c \
    --random-effect --exclude-effects dev_worm \
    --no-eol --no-restore-cursor &

  effect_pid=$!
  while kill -0 "$effect_pid" 2>/dev/null; do
    if read -rsn1 -t 1 || ! screensaver_in_focus; then
      exit 0
    fi
  done
  wait "$effect_pid" || exit "$?"
  effect_pid=
done
