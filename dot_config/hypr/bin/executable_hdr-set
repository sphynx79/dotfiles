#!/bin/bash
# Attiva/disattiva l'HDR sul monitor (cm = "hdr" oppure il default SDR "dcip3").
#
#   hdr-set on|off|toggle    cambia stato
#   hdr-set --current        stampa "on" o "off"
#
# Lo stato vive in $XDG_STATE_HOME/hypr/hdr; hyprland.lua lo legge nel blocco
# MONITOR per scegliere il cm, quindi qui basta scrivere lo stato e fare
# hyprctl reload (unica fonte di verita' per i parametri monitor: hyprland.lua).
set -euo pipefail

state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/hypr"
state_file="$state_dir/hdr"
mkdir -p "$state_dir"

current="off"
[[ -f "$state_file" ]] && current=$(<"$state_file")

case "${1:-}" in
--current)
    echo "$current"
    exit 0
    ;;
on | off)
    new="$1"
    ;;
toggle)
    new=$([[ "$current" == "on" ]] && echo off || echo on)
    ;;
*)
    sed -n '2,9p' "$0" | sed 's/^# \?//'
    exit 0
    ;;
esac

echo "$new" > "$state_file"
hyprctl reload >/dev/null
notify-send -i preferences-desktop-display "HDR" "${new^^}" 2>/dev/null || true
