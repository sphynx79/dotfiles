#!/usr/bin/env bash

for cmd in pacman fzf sudo show-done; do
  command -v "$cmd" >/dev/null || {
    printf 'Missing command: %s\n' "$cmd" >&2
    exit 127
  }
done

fzf_args=(
  --multi
  --preview 'pacman -Qi {1}'
  --preview-label='alt-p: toggle description, alt-j/k: scroll, tab: multi-select'
  --preview-label-pos='bottom'
  --preview-window 'down:65%:wrap'
  --bind 'alt-p:toggle-preview'
  --bind 'alt-d:preview-half-page-down,alt-u:preview-half-page-up'
  --bind 'alt-k:preview-up,alt-j:preview-down'
  --color 'pointer:red,marker:red'
)

pkg_names=$(pacman -Qqe) || exit "$?"
pkg_names=$(printf '%s\n' "$pkg_names" | fzf "${fzf_args[@]}")
status=$?
case "$status" in
0) ;;
1 | 130) exit 0 ;;
*) exit "$status" ;;
esac
[[ -n "$pkg_names" ]] || exit 0

mapfile -t packages <<<"$pkg_names"
sudo pacman -Rns -- "${packages[@]}"
status=$?
if ((status == 0)); then
  show-done
else
  printf 'Package removal failed (exit %s).\n' "$status" >&2
fi
exit "$status"
