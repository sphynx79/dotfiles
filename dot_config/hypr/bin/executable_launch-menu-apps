#!/usr/bin/env bash

walker --close || exit
# A separate instance reports cancellation; isolate its activation socket too.
bwrap --bind / / --dev-bind /dev /dev --tmpfs "$XDG_RUNTIME_DIR/walker" -- dbus-run-session -- walker
status=$?
if [[ $status -eq 130 ]]; then
  exec launch-menu
fi
exit "$status"
