#!/usr/bin/env bash

for cmd in yay fzf sudo updatedb show-done; do
  command -v "$cmd" >/dev/null || {
    printf 'Missing command: %s\n' "$cmd" >&2
    exit 127
  }
done

fzf_args=(
  --multi
  --preview 'yay -Siia {1}'
  --preview-label='alt-p: toggle description, alt-b/B: toggle PKGBUILD, alt-j/k: scroll, tab: multi-select'
  --preview-label-pos='bottom'
  --preview-window 'down:65%:wrap'
  --bind 'alt-p:toggle-preview'
  --bind 'alt-d:preview-half-page-down,alt-u:preview-half-page-up'
  --bind 'alt-k:preview-up,alt-j:preview-down'
  --bind 'alt-b:change-preview:yay -Gpa {1} | tail -n +5'
  --bind 'alt-B:change-preview:yay -Siia {1}'
  --color 'pointer:green,marker:green'
)

pkg_names=$(yay -Slqa) || exit "$?"
pkg_names=$(printf '%s\n' "$pkg_names" | fzf "${fzf_args[@]}")
status=$?
case "$status" in
0) ;;
1 | 130) exit 0 ;;
*) exit "$status" ;;
esac
[[ -n "$pkg_names" ]] || exit 0

mapfile -t packages <<<"$pkg_names"
yay -S --noconfirm -- "${packages[@]}"
status=$?
if ((status == 0)); then
  sudo updatedb
  show-done
else
  printf 'AUR installation failed (exit %s).\n' "$status" >&2
fi
exit "$status"
