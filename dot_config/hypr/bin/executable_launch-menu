#!/bin/bash

# Opens the walker menu tree (elephant Lua providers in ~/.config/hypr/elephant/menus)
# with the narrow "menus" theme. Without arguments opens the main menu set;
# with arguments they are passed to walker, e.g.: launch-menu -m menus:system

# Ensure elephant is running before launching walker
if ! pgrep -x elephant > /dev/null; then
  setsid uwsm-app -- elephant &
fi

# Ensure walker service is running
if ! pgrep -f "walker --gapplication-service" > /dev/null; then
  setsid app2unit.sh -t service walker --gapplication-service &
fi

if [[ $# -eq 0 ]]; then
  exec walker -t menus -s menu -N
else
  exec walker -t menus -N "$@"
fi
