#!/usr/bin/env bash

# Restarts elephant and the walker gapplication-service.
# Walker runs as a transient app2unit unit with a generated name
# (e.g. app-Hyprland-walker@<hash>.service), so it is stopped by
# killing the process and relaunched via app2unit.
# Exit status is expanded by the shell executing restart_cmd.
# shellcheck disable=SC2016
restart_cmd='
  systemctl --user restart elephant.service || exit "$?"
  pkill -x walker
  # Wait until elephant actually answers on its socket: if walker starts
  # while elephant is still coming up, the "Waiting for elephant..." hint
  # gets stuck visible and breaks the layout.
  for _ in $(seq 1 20); do
    if elephant query --async=false "menus:menu;;1;false" >/dev/null 2>&1; then
      setsid app2unit.sh -t service walker --gapplication-service >/dev/null 2>&1 &
      exit 0
    fi
    sleep 0.5
  done
  printf "Elephant did not become ready; Walker was not started.\n" >&2
  exit 1
'

# Detect if we're running as root (from pacman hook)
if [[ $EUID -eq 0 ]]; then
  # Get the owner of this script to determine which user to run as
  SCRIPT_OWNER=$(stat -c '%U' "$0")
  USER_UID=$(id -u "$SCRIPT_OWNER")

  # Restart services as the script owner
  systemd-run --uid="$SCRIPT_OWNER" --setenv=XDG_RUNTIME_DIR="/run/user/$USER_UID" \
    bash -c "$restart_cmd"
else
  bash -c "$restart_cmd"
fi
