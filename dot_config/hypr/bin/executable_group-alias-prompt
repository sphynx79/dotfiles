#!/usr/bin/env bash

# Chiede via walker il nome da mostrare nella tab della groupbar per la finestra
# attiva (plugin group-alias). Input vuoto o annullato = nessuna modifica; per
# rimuovere l'alias c'e' `hyprctl groupalias clear`.
#
# Walker e' un layer surface: la finestra attiva non cambia mentre il prompt e' aperto,
# quindi l'alias finisce sulla finestra giusta.

set -uo pipefail

HYPR_BIN="$HOME/.config/hypr/bin"
if [[ ":$PATH:" != *":$HYPR_BIN:"* ]]; then
  export PATH="$HYPR_BIN:$PATH"
fi

if ! hyprctl -j plugin list 2>/dev/null | jq -e 'any(.[]; .name == "group-alias")' >/dev/null; then
  notify-send -a Hyprland "group-alias" "Plugin non caricato" 2>/dev/null
  exit 1
fi

current=$(hyprctl groupalias get 2>/dev/null | head -1)

if [[ -n "$current" ]]; then
  prompt="Nome tab (attuale: $current)"
else
  prompt="Nome tab"
fi

alias_name=$(printf '' | launch-walker --dmenu --inputonly --width 500 --minheight 1 --maxheight 1 -p "$prompt…" 2>/dev/null) || exit 0

# Esc / annullamento
[[ -z "${alias_name+x}" ]] && exit 0

[[ -z "${alias_name// /}" ]] && exit 0

hyprctl groupalias set "$alias_name" >/dev/null
