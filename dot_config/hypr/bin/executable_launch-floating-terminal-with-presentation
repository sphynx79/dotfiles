#!/usr/bin/env bash

# Variables in the command below belong to the terminal's child shell.
# shellcheck disable=SC2016
exec setsid app2unit.sh xdg-terminal-exec --app-id=org.hyprarch.terminal --title=HyprArch -e bash -c '
  show-logo
  bash -c "$1"
  status=$?
  if ((status == 0)); then
    show-done
  else
    printf "\nCommand failed (exit %s). Press any key to close...\n" "$status" >&2
    read -r -s -n 1
  fi
  exit "$status"
' bash "$*"
