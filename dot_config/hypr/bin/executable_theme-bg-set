#!/bin/bash

# Sets a specific background image (companion of theme-bg-next,
# used by the walker menus:wallpapers menu)

BACKGROUND="$1"
CURRENT_BACKGROUND_LINK="$HOME/.config/hypr/themes/current/background"

if [[ ! -f "$BACKGROUND" ]]; then
  notify-send "Background not found" "$BACKGROUND" -t 2000
  exit 1
fi

# Set new background symlink
ln -nsf "$BACKGROUND" "$CURRENT_BACKGROUND_LINK"

# Relaunch swaybg
pkill -x swaybg
setsid app2unit.sh -t service swaybg -i "$CURRENT_BACKGROUND_LINK" -m fill >/dev/null 2>&1 &
